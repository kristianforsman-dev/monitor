        + '  <input class="fmInput fmIntExpected" type="number" step="1" value="' + esc(it.expected == null ? '' : it.expected) + '">'
        + '  <input class="fmInput fmIntWarnPct" type="number" step="0.01" value="' + esc(it.warnAtPct == null ? '' : it.warnAtPct) + '">'
