(function(w){
  'use strict';

  var state = {
    preset: '1d',
    range: null,
    rows: [],
    monitoring: [],
    selectedId: '',
    search: '',
    sender: '',
    receiver: '',
    status: '',
    monitoringConfig: null,
    editingFlowId: ''
  };

  function todayISO(){
    try{
      if(w.FM && w.FM.state && w.FM.state.mockToday){
        return String(w.FM.state.mockToday);
      }
    }catch(e){}
    var d = new Date();
    var y = d.getFullYear();
    var m = String(d.getMonth()+1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }

  function addDays(iso, delta){
    var d = new Date(iso + 'T00:00:00');
    d.setDate(d.getDate() + delta);
    var y = d.getFullYear();
    var m = String(d.getMonth()+1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }

  function presetToRange(preset){
    var to = todayISO();
    if(preset === '30d') return { from:addDays(to, -29), to:to };
    if(preset === '7d') return { from:addDays(to, -6), to:to };
    return { from:to, to:to };
  }

  function esc(v){
    return String(v == null ? '' : v)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;');
  }

  function byId(id){ return document.getElementById(id); }

  function rowKey(r){
    return [r.sender||'', r.receiver||'', r.msgType||'', r.state||''].join('|');
  }

  async function fetchJson(url, init){
    var r = await fetch(url, init || { cache:'no-store' });
    if(!r.ok) throw new Error(url + ' -> ' + r.status);
    return await r.json();
  }

  function hideLegacyDetails(){
    var ids = [
      'detailPane','detailPanel','flowDetail','detailDrawerHost','detailHost',
      'detail','details','detailView','flowDetails','detailContainer',
      'monEditorBackdrop'
    ];
    for(var i=0;i<ids.length;i++){
      var el = byId(ids[i]);
      if(el){
        el.style.display = 'none';
        el.hidden = true;
      }
    }
    var sels = ['.legacyDetail','.detailInline','.detailPane','.detailPanel','.flowDetailInline'];
    for(var j=0;j<sels.length;j++){
      var nodes = document.querySelectorAll(sels[j]);
      for(var k=0;k<nodes.length;k++){
        nodes[k].style.display = 'none';
        nodes[k].hidden = true;
      }
    }
  }

  async function refresh(){
    if(!state.range || !state.range.from || !state.range.to){
      state.range = presetToRange('1d');
    }

    var q = '?from=' + encodeURIComponent(state.range.from) + '&to=' + encodeURIComponent(state.range.to);

    var results = await Promise.all([
      fetchJson('api/range' + q, { cache:'no-store' }),
      fetchJson('api/monitoring' + q, { cache:'no-store' })
    ]);

    state.rows = Array.isArray(results[0] && results[0].rows) ? results[0].rows : [];
    state.monitoring = Array.isArray(results[1] && results[1].rows) ? results[1].rows : [];

    if(state.selectedId){
      var exists = false;
      for(var i=0;i<state.rows.length;i++){
        if(rowKey(state.rows[i]) === state.selectedId){ exists = true; break; }
      }
      if(!exists) state.selectedId = '';
    }

    render();
  }

  function filteredRows(){
    var out = [];
    var q = String(state.search || '').trim().toLowerCase();

    for(var i=0;i<state.rows.length;i++){
      var r = state.rows[i] || {};
      if(state.sender && String(r.sender || '') !== state.sender) continue;
      if(state.receiver && String(r.receiver || '') !== state.receiver) continue;
      if(state.status && String(r.state || '') !== state.status) continue;

      if(q){
        var hay = (
          String(r.sender || '') + ' ' +
          String(r.receiver || '') + ' ' +
          String(r.msgType || '') + ' ' +
          String(r.state || '')
        ).toLowerCase();
        if(hay.indexOf(q) === -1) continue;
      }

      out.push(r);
    }

    out.sort(function(a,b){
      var ak = (String(a.sender||'') + '|' + String(a.receiver||'') + '|' + String(a.msgType||'') + '|' + String(a.state||'')).toLowerCase();
      var bk = (String(b.sender||'') + '|' + String(b.receiver||'') + '|' + String(b.msgType||'') + '|' + String(b.state||'')).toLowerCase();
      if(ak < bk) return -1;
      if(ak > bk) return 1;
      return 0;
    });

    return out;
  }

  function uniqueValues(key){
    var seen = Object.create(null);
    var out = [];
    for(var i=0;i<state.rows.length;i++){
      var v = String((state.rows[i] || {})[key] || '');
      if(!v || seen[v]) continue;
      seen[v] = true;
      out.push(v);
    }
    out.sort();
    return out;
  }

  function monitorBadgeCls(status){
    status = String(status || '').toUpperCase();
    if(status === 'ERROR') return 'error';
    if(status === 'WARNING') return 'warning';
    return 'info';
  }

