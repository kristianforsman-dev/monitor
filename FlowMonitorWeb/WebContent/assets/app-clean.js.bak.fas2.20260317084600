  function render(){
    ensureRoot();
    hideLegacyDetails();

    var meta = byId('fmRangeMeta');
    if(meta){
      meta.textContent = state.range ? (state.range.from + ' → ' + state.range.to) : '';
    }

    var fromEl = byId('fmDateFrom');
    var toEl = byId('fmDateTo');
    if(fromEl && state.range) fromEl.value = state.range.from || '';
    if(toEl && state.range) toEl.value = state.range.to || '';

    var presetBtns = document.querySelectorAll('#fmCleanApp .fmPreset');
    for(var i=0;i<presetBtns.length;i++){
      presetBtns[i].classList.remove('isActive');
    }

    renderFilterOptions();
    renderTable();
    renderMonitoring();

    var stray = document.querySelectorAll('#fmCleanApp .fmBtn.isActive, #fmCleanApp .fmBtnGhost.isActive, #fmCleanApp .fmBtnPrimary.isActive');
    for(var i=0;i<stray.length;i++){
      stray[i].classList.remove('isActive');
    }
  }

  function renderFilterOptions(){
    renderSelect('fmSender', uniqueValues('sender'), 'Alla avsändare', state.sender);
    renderSelect('fmReceiver', uniqueValues('receiver'), 'Alla mottagare', state.receiver);
    renderSelect('fmStatus', uniqueValues('state'), 'Alla statusar', state.status);

    var search = byId('fmSearch');
    if(search && search.value !== state.search) search.value = state.search;
  }

  function renderSelect(id, values, placeholder, selected){
    var el = byId(id);
    if(!el) return;
    var html = '<option value="">' + esc(placeholder) + '</option>';
    for(var i=0;i<values.length;i++){
      var v = values[i];
      html += '<option value="' + esc(v) + '"' + (v === selected ? ' selected' : '') + '>' + esc(v) + '</option>';
    }
    el.innerHTML = html;
  }

  function renderTable(){
    var body = byId('fmTableBody');
    var hint = byId('fmTableHint');
    if(!body || !hint) return;

    var rows = filteredRows();
    if(!rows.length){
      body.innerHTML = '<tr><td colspan="5" class="fmEmpty">Inga rader matchar filtren.</td></tr>';
      hint.textContent = '0 rader';
      return;
    }

    var html = '';
    for(var i=0;i<rows.length;i++){
      var r = rows[i];
      var id = rowKey(r);
      html += ''
        + '<tr class="' + (state.selectedId === id ? 'isSelected' : '') + '" data-rowid="' + esc(id) + '">'
        + '  <td class="fmMono">' + esc(r.sender) + '</td>'
        + '  <td class="fmMono">' + esc(r.receiver) + '</td>'
        + '  <td>' + esc(r.msgType) + '</td>'
        + '  <td>' + esc(r.state) + '</td>'
        + '  <td class="fmNum fmMono">' + esc(r.count) + '</td>'
        + '</tr>';
    }
    body.innerHTML = html;
    hint.textContent = rows.length + ' rader';

    var trs = body.querySelectorAll('tr[data-rowid]');
    for(var j=0;j<trs.length;j++){
      (function(tr){
        tr.addEventListener('click', function(){
          state.selectedId = tr.getAttribute('data-rowid') || '';
          var all = body.querySelectorAll('tr[data-rowid]');
          for(var k=0;k<all.length;k++) all[k].classList.remove('isSelected');
          tr.classList.add('isSelected');
        });

        tr.addEventListener('dblclick', function(){
          var id = tr.getAttribute('data-rowid') || '';
          state.selectedId = id;
          var all = body.querySelectorAll('tr[data-rowid]');
          for(var k=0;k<all.length;k++) all[k].classList.remove('isSelected');
          tr.classList.add('isSelected');
          openDetail(findRowById(id));
        });
      })(trs[j]);
    }
  }

  function renderMonitoring(){
    var host = byId('fmMonitorList');
    if(!host) return;

    if(!state.monitoring.length){
      host.innerHTML = '<div class="fmEmpty">Inga bevakningar att visa.</div>';
      return;
    }

    var html = '';
    for(var i=0;i<state.monitoring.length;i++){
      var r = state.monitoring[i] || {};
      var status = String(r.status || 'INFO').toUpperCase();
      var badgeCls = monitorBadgeCls(status);
      var meta = [];
      if(r.mode) meta.push(r.mode);
      if(r.message) meta.push(r.message);
      if(r.details) meta.push(r.details);

      html += ''
        + '<div class="fmMonitorItem" data-flowid="' + esc(r.flowId || '') + '">'
        + '  <div class="fmMonitorMain">'
        + '    <div class="fmMonitorName">' + esc(r.name || r.flowId || '') + '</div>'
        + '    <div class="fmMonitorMeta">' + esc(meta.join(' • ')) + '</div>'
        + '  </div>'
        + '  <div class="fmMonitorActions">'
        + '    <span class="fmBadge ' + badgeCls + '">' + esc(status) + '</span>'
        + '  </div>'
        + '</div>';
    }

    host.innerHTML = html;
  }

  function openDetail(row){
    if(!row) return;
    hideLegacyDetails();

    var body = byId('fmDetailBody');
    var backdrop = byId('fmDetailBackdrop');
    if(!body || !backdrop) return;

    body.innerHTML = ''
      + '<div class="fmDetailGrid">'
      + '  <div class="fmDetailItem"><span class="fmDetailLabel">Avsändare</span><span class="fmDetailValue fmMono">' + esc(row.sender) + '</span></div>'
      + '  <div class="fmDetailItem"><span class="fmDetailLabel">Mottagare</span><span class="fmDetailValue fmMono">' + esc(row.receiver) + '</span></div>'
      + '  <div class="fmDetailItem"><span class="fmDetailLabel">Meddelandetyp</span><span class="fmDetailValue">' + esc(row.msgType) + '</span></div>'
      + '  <div class="fmDetailItem"><span class="fmDetailLabel">Status</span><span class="fmDetailValue">' + esc(row.state) + '</span></div>'
      + '  <div class="fmDetailItem"><span class="fmDetailLabel">Antal</span><span class="fmDetailValue fmMono">' + esc(row.count) + '</span></div>'
      + '</div>';

    backdrop.hidden = false;
  }

  function closeDetail(){
    var backdrop = byId('fmDetailBackdrop');
    if(backdrop) backdrop.hidden = true;
  }

  function findRowById(id){
    for(var i=0;i<state.rows.length;i++){
      if(rowKey(state.rows[i]) === id) return state.rows[i];
    }
    return null;
  }

  async function loadMonitoringConfig(){
    return await fetchJson('api/monitoring-config', { cache:'no-store' });
  }

  async function saveMonitoringConfig(cfg){
    return await fetchJson('api/monitoring-config', {
      method:'POST',
      headers:{ 'Content-Type':'application/json; charset=UTF-8' },
      body: JSON.stringify(cfg, null, 2)
    });
  }

  function normalizeEditorRule(flow){
    var x = {
      mode: 'interval',
      intervals: [],
      times: [],
      weekdays: [],
      monthDays: [],
      dates: [],
      expected: '',
      dueTime: '',
      carryOverMode: 'sameDay'
    };

    var sched = (flow && flow.schedule && typeof flow.schedule === 'object') ? flow.schedule : null;
    if(sched){
      var t = String(sched.type || '').trim();
      if(t === 'interval'){
        x.mode = 'interval';
        x.intervals = Array.isArray(sched.intervals) ? sched.intervals : [];
      }else if(t === 'exactTimes' || t === 'exacttimes'){
        x.mode = 'exactTimes';
        x.times = Array.isArray(sched.times) ? sched.times : [];
      }else if(t === 'weekdays'){
        x.mode = 'weekdays';
        x.weekdays = Array.isArray(sched.weekdays) ? sched.weekdays : [];
        x.expected = sched.expected == null ? '' : String(sched.expected);
        x.dueTime = String(sched.dueTime || '');
        x.carryOverMode = String(sched.carryOverMode || 'sameDay');
      }else if(t === 'monthDays' || t === 'monthdays'){
        x.mode = 'monthDays';
        x.monthDays = Array.isArray(sched.monthDays) ? sched.monthDays : [];
        x.expected = sched.expected == null ? '' : String(sched.expected);
        x.dueTime = String(sched.dueTime || '');
        x.carryOverMode = String(sched.carryOverMode || 'sameDay');
      }else if(t === 'dates'){
        x.mode = 'dates';
        x.dates = Array.isArray(sched.dates) ? sched.dates : [];
        x.expected = sched.expected == null ? '' : String(sched.expected);
        x.dueTime = String(sched.dueTime || '');
        x.carryOverMode = String(sched.carryOverMode || 'sameDay');
      }
      return x;
    }

    return x;
  }

