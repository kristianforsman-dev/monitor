      html += ''
        + '<div class="fmRuleRow" data-kind="time">'
        + '  <input class="fmInput fmTimeAt" type="time" value="' + esc(it.time || '') + '">'
        + '  <input class="fmInput fmTimeExpected" type="number" step="1" value="' + esc(it.expected == null ? '' : it.expected) + '">'
        + '  <button type="button" class="fmBtn fmBtnGhost fmRowRemove">−</button>'
        + '</div>';
    }
    host.innerHTML = html;
  }

  function renderWeekdayChecks(values){
    values = Array.isArray(values) ? values : [];
    var host = byId('fmMonWeekdaysChecks');
    if(!host) return;
    var labels = [
      { v:1, t:'Mån' },
      { v:2, t:'Tis' },
      { v:3, t:'Ons' },
      { v:4, t:'Tor' },
      { v:5, t:'Fre' },
      { v:6, t:'Lör' },
      { v:7, t:'Sön' }
    ];
    var html = '';
    for(var i=0;i<labels.length;i++){
      var it = labels[i];
      var checked = values.indexOf(it.v) !== -1 ? ' checked' : '';
      html += '<label class="fmCheck"><input type="checkbox" class="fmWeekdayChk" value="' + it.v + '"' + checked + '> ' + it.t + '</label>';
    }
    host.innerHTML = html;
  }

  function collectWeekdays(){
    var nodes = document.querySelectorAll('#fmMonWeekdaysChecks .fmWeekdayChk:checked');
    var out = [];
    for(var i=0;i<nodes.length;i++) out.push(Number(nodes[i].value));
    return out;
  }

  function renderMonthDayChips(values){
    values = Array.isArray(values) ? values.slice() : [];
    values.sort(function(a,b){ return a-b; });

    var host = byId('fmMonMonthDaysGrid');
    var summary = byId('fmMonMonthDaysSummary');
    if(!host) return;

    var html = '';
    for(var d=1; d<=31; d++){
      var selected = values.indexOf(d) !== -1;
      var active = selected ? ' isActive' : '';
      html += ''
        + '<button'
        + ' type="button"'
        + ' class="fmBtn fmChip' + active + '"'
        + ' data-day="' + d + '"'
        + ' aria-pressed="' + (selected ? 'true' : 'false') + '"'
        + ' title="Dag ' + d + '">'
        + ' <span class="fmChipLabel">' + d + '</span>'
        + '</button>';
    }
    host.innerHTML = html;

    if(summary){
      summary.textContent = values.length
        ? ('Valda dagar: ' + values.join(', '))
        : 'Inga månadsdagar valda';
    }
  }

  function collectMonthDays(){
    var nodes = document.querySelectorAll('#fmMonMonthDaysGrid .fmChip.isActive');
    var out = [];
    for(var i=0;i<nodes.length;i++) out.push(Number(nodes[i].getAttribute('data-day') || 0));
    return out;
  }

  function renderDateRows(values){
    values = Array.isArray(values) ? values : [];
    var host = byId('fmMonDatesRows');
    if(!host) return;
    if(!values.length) values = [''];
    var html = '';
    for(var i=0;i<values.length;i++){
      var v = values[i] || '';
      html += ''
        + '<div class="fmDateRow">'
        + '  <input type="date" class="fmInput fmDateVal" value="' + esc(v) + '">'
        + '  <button type="button" class="fmBtn fmBtnGhost fmDateRemove">−</button>'
        + '</div>';
    }
    host.innerHTML = html;
  }

  function collectDates(){
    var nodes = document.querySelectorAll('#fmMonDatesRows .fmDateVal');
    var out = [];
    for(var i=0;i<nodes.length;i++){
      var v = String(nodes[i].value || '').trim();
      if(v) out.push(v);
    }
    return out;
  }

  function collectIntervalRows(){
    var host = byId('fmMonIntervalsGrid');
    if(!host) return [];
    var rows = host.querySelectorAll('.fmRuleRow[data-kind="interval"]');
    var out = [];
    for(var i=0;i<rows.length;i++){
      var r = rows[i];
      out.push({
        start: (r.querySelector('.fmIntStart') || {}).value || '',
        end: (r.querySelector('.fmIntEnd') || {}).value || '',
        expected: Number(((r.querySelector('.fmIntExpected') || {}).value) || 0),
        warnAtPct: Number(((r.querySelector('.fmIntWarnPct') || {}).value) || 0),
        tolerancePct: Number(((r.querySelector('.fmIntTolPct') || {}).value) || 0)
      });
    }
    return out.filter(function(x){ return x.start && x.end && x.expected > 0; });
  }

  function collectTimeRows(){
    var host = byId('fmMonTimesGrid');
    if(!host) return [];
    var rows = host.querySelectorAll('.fmRuleRow[data-kind="time"]');
    var out = [];
    for(var i=0;i<rows.length;i++){
      var r = rows[i];
      out.push({
        time: (r.querySelector('.fmTimeAt') || {}).value || '',
        expected: Number(((r.querySelector('.fmTimeExpected') || {}).value) || 0)
      });
    }
    return out.filter(function(x){ return x.time && x.expected > 0; });
  }

  function toggle(id, yes){
    var el = byId(id);
    if(el) el.style.display = yes ? '' : 'none';
  }

  function syncMonitorModeUi(){
    var mode = String((byId('fmMonMode') || {}).value || 'interval');
    toggle('fmMonIntervalsWrap', mode === 'interval');
    toggle('fmMonTimesWrap', mode === 'exactTimes');
    toggle('fmMonExpectedWrap', mode === 'weekdays' || mode === 'monthDays' || mode === 'dates');
    toggle('fmMonDueTimeWrap', mode === 'weekdays' || mode === 'monthDays' || mode === 'dates');
    toggle('fmMonCarryWrap', mode === 'weekdays' || mode === 'monthDays' || mode === 'dates');
    toggle('fmMonWeekdaysWrap', mode === 'weekdays');
    toggle('fmMonMonthDaysWrap', mode === 'monthDays');
    toggle('fmMonDatesWrap', mode === 'dates');
  }

  function closeMonitorEditor(){
    var b = byId('fmMonitorBackdrop');
    if(b) b.hidden = true;
    state.editingFlowId = '';
    state.monitoringConfig = null;
  }

  async function openMonitorEditor(flowId){
    try{
      hideLegacyDetails();

      var cfg = await loadMonitoringConfig();
      cfg = cfg || {};
      cfg.defaults = cfg.defaults || {};
      cfg.flows = Array.isArray(cfg.flows) ? cfg.flows : [];

      var isNew = (flowId === '__NEW__');
      var flow = null;

      if(!isNew){
        for(var i=0;i<cfg.flows.length;i++){
          if(String(cfg.flows[i].flowId || '') === String(flowId)){
            flow = cfg.flows[i];
            break;
          }
        }
        if(!flow) throw new Error('Kunde inte hitta bevakning för ' + flowId);
      }else{
        flow = {
          flowId:'',
          name:'',
          enabled:true,
          schedule:{
            type:'interval',
            intervals:[{ start:'', end:'', expected:0, warnAtPct:0.7, tolerancePct:0.05 }]
          }
        };
      }

      var n = normalizeEditorRule(flow);
      var parts = String(flow.flowId || '').split('||');

      state.monitoringConfig = cfg;
      state.editingFlowId = flowId;

      byId('fmMonitorTitle').textContent = isNew ? 'Ny bevakning' : 'Redigera bevakning';
      byId('fmMonSender').value = parts[0] || '';
      byId('fmMonReceiver').value = parts[1] || '';
      byId('fmMonMsgType').value = parts.slice(2).join('||') || '';
      byId('fmMonName').value = flow.name || '';
      byId('fmMonEnabled').checked = flow.enabled !== false;
      byId('fmMonMode').value = n.mode;
      byId('fmMonWarnLead').value = flow.warningLeadMinutes == null ? '' : String(flow.warningLeadMinutes);
      byId('fmMonErrorGrace').value = flow.errorGraceMinutes == null ? '' : String(flow.errorGraceMinutes);
      byId('fmMonExpected').value = n.expected;
      byId('fmMonDueTime').value = n.dueTime || '';
      byId('fmMonCarry').value = n.carryOverMode || 'sameDay';

      renderIntervalRows((n.intervals && n.intervals.length) ? n.intervals : [{ start:'', end:'', expected:0, warnAtPct:0.7, tolerancePct:0.05 }]);
      renderTimeRows((n.times && n.times.length) ? n.times : [{ time:'', expected:0 }]);
      renderWeekdayChecks(n.weekdays || []);
      renderMonthDayChips(n.monthDays || []);
      renderDateRows(n.dates || []);

      var err = byId('fmMonError');
      var ok = byId('fmMonSuccess');
      if(err){ err.hidden = true; err.textContent = ''; }
      if(ok){ ok.hidden = true; ok.textContent = 'Sparat'; }

      syncMonitorModeUi();
      byId('fmMonitorBackdrop').hidden = false;
      byId('fmMonSender').focus();
    }catch(e){
      alert('Kunde inte öppna editor: ' + (e && e.message ? e.message : e));
    }
  }

  async function saveMonitorEditor(){
    var cfg = state.monitoringConfig;
    var flowId = state.editingFlowId;
    var isNew = (flowId === '__NEW__');
    if(!cfg) throw new Error('Ingen aktiv config');

    cfg.flows = Array.isArray(cfg.flows) ? cfg.flows : [];

    var flow = null;
    if(isNew){
      flow = {};
      cfg.flows.push(flow);
    }else{
      for(var i=0;i<cfg.flows.length;i++){
        if(String(cfg.flows[i].flowId || '') === String(flowId)){
          flow = cfg.flows[i];
          break;
        }
      }
      if(!flow) throw new Error('Kunde inte hitta flow i config');
    }

    var sender = (byId('fmMonSender').value || '').trim();
    var receiver = (byId('fmMonReceiver').value || '').trim();
    var msgType = (byId('fmMonMsgType').value || '').trim();
    if(!sender || !receiver || !msgType){
      throw new Error('Avsändare, Mottagare och Meddelandetyp måste anges');
    }

    flow.flowId = sender + '||' + receiver + '||' + msgType;
    flow.name = (byId('fmMonName').value || '').trim();
    flow.enabled = !!byId('fmMonEnabled').checked;

    var warnLeadRaw = byId('fmMonWarnLead').value;
    var errGraceRaw = byId('fmMonErrorGrace').value;
    flow.warningLeadMinutes = warnLeadRaw === '' ? null : Number(warnLeadRaw);
    flow.errorGraceMinutes = errGraceRaw === '' ? null : Number(errGraceRaw);

    var mode = String(byId('fmMonMode').value || 'interval');
    var schedule = { type: mode };

    if(mode === 'interval'){
      schedule.intervals = collectIntervalRows();
    }else if(mode === 'exactTimes'){
      schedule.times = collectTimeRows();
    }else if(mode === 'weekdays'){
      schedule.expected = Number(byId('fmMonExpected').value || 0);
      schedule.dueTime = String(byId('fmMonDueTime').value || '').trim();
      schedule.carryOverMode = String(byId('fmMonCarry').value || 'sameDay');
      schedule.weekdays = collectWeekdays();
    }else if(mode === 'monthDays'){
      schedule.expected = Number(byId('fmMonExpected').value || 0);
      schedule.dueTime = String(byId('fmMonDueTime').value || '').trim();
      schedule.carryOverMode = String(byId('fmMonCarry').value || 'sameDay');
      schedule.monthDays = collectMonthDays();
    }else if(mode === 'dates'){
      schedule.expected = Number(byId('fmMonExpected').value || 0);
      schedule.dueTime = String(byId('fmMonDueTime').value || '').trim();
      schedule.carryOverMode = String(byId('fmMonCarry').value || 'sameDay');
      schedule.dates = collectDates();
    }

    flow.schedule = schedule;

    var saveBtn = byId('fmMonitorSave');
    var err = byId('fmMonError');
    var ok = byId('fmMonSuccess');
    if(err){ err.hidden = true; err.textContent = ''; }
    if(ok){ ok.hidden = true; ok.textContent = 'Sparat'; }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Sparar...';
    try{
      await saveMonitoringConfig(cfg);
      state.monitoringConfig = null;
      state.editingFlowId = '';
      if(ok) ok.hidden = false;
      await refresh();
      closeMonitorEditor();
    }finally{
      saveBtn.disabled = false;
      saveBtn.textContent = 'Spara';
    }
  }

  function bindEvents(){
    var root = byId('fmCleanApp');
    if(!root || root.__wired) return;
    root.__wired = true;

    root.addEventListener('pointerup', function(e){
      var btn = e.target && e.target.closest ? e.target.closest('.fmBtn, .fmBtnGhost, .fmBtnPrimary, .fmPreset') : null;
      if(btn){
        try{ btn.blur(); }catch(ignore){}
      }
    });

    root.addEventListener('click', function(e){
      var preset = e.target.closest ? e.target.closest('.fmPreset') : null;
      if(preset){
        var quick = preset.getAttribute('data-preset') || '1d';
        state.range = presetToRange(quick);

        var fromEl = byId('fmDateFrom');
        var toEl = byId('fmDateTo');
        if(fromEl) fromEl.value = state.range.from || '';
        if(toEl) toEl.value = state.range.to || '';

        refresh().catch(showError);
        return;
      }

      if(e.target.id === 'fmApplyDates'){
        var fromEl = byId('fmDateFrom');
        var toEl = byId('fmDateTo');
        var from = fromEl ? String(fromEl.value || '').trim() : '';
        var to = toEl ? String(toEl.value || '').trim() : '';
        if(!from || !to){
          alert('Välj både från- och tilldatum.');
          return;
        }
        state.preset = 'custom';
        state.range = { from: from, to: to };
        refresh().catch(showError);
        return;
      }

      if(e.target.id === 'fmClearFilters'){
        state.search = '';
        state.sender = '';
        state.receiver = '';
        state.status = '';
        render();
        return;
      }

      if(e.target.id === 'fmDetailCloseBtn' || e.target.id === 'fmDetailCloseX'){
        closeDetail();
        return;
      }

      if(e.target.id === 'fmNewMonitor'){
        openMonitorEditor('__NEW__');
        return;
      }

      var row = e.target.closest ? e.target.closest('#fmTableBody tr[data-rowid]') : null;
      if(row){
        state.selectedId = row.getAttribute('data-rowid') || '';
        renderTable();
        return;
      }


      if(e.target.id === 'fmDetailBackdrop'){
        closeDetail();
        return;
      }

      if(e.target.id === 'fmMonitorBackdrop'){
        closeMonitorEditor();
        return;
      }

      if(e.target.id === 'fmMonitorCloseX' || e.target.id === 'fmMonitorCancel'){
        closeMonitorEditor();
        return;
      }

      if(e.target.id === 'fmMonitorSave'){
        saveMonitorEditor().catch(function(err2){
          var box = byId('fmMonError');
          if(box){
            box.hidden = false;
            box.textContent = 'Kunde inte spara: ' + (err2 && err2.message ? err2.message : err2);
          }
        });
        return;
      }

      if(e.target.id === 'fmAddInterval'){
        var items = collectIntervalRows();
        items.push({ start:'', end:'', expected:0, warnAtPct:0.7, tolerancePct:0.05 });
        renderIntervalRows(items);
        return;
      }

      if(e.target.id === 'fmAddTime'){
        var titems = collectTimeRows();
        titems.push({ time:'', expected:0 });
        renderTimeRows(titems);
        return;
      }

      if(e.target.id === 'fmMonthPickCommon'){
        renderMonthDayChips([1, 15, 28]);
        return;
      }

      if(e.target.id === 'fmMonthClearAll'){
        renderMonthDayChips([]);
        return;
      }

      if(e.target.id === 'fmAddDate'){
        var dates = collectDates();
        dates.push('');
        renderDateRows(dates);
        return;
      }

      var removeBtn = e.target.closest ? e.target.closest('.fmRowRemove') : null;
      if(removeBtn){
        var rowNode = removeBtn.closest('.fmRuleRow');
        if(rowNode && rowNode.parentNode) rowNode.parentNode.removeChild(rowNode);
        return;
      }

      var dateRemove = e.target.closest ? e.target.closest('.fmDateRemove') : null;
      if(dateRemove){
        var dateRow = dateRemove.closest('.fmDateRow');
        if(dateRow && dateRow.parentNode) dateRow.parentNode.removeChild(dateRow);
        if(!document.querySelector('#fmMonDatesRows .fmDateRow')) renderDateRows(['']);
        return;
      }

      var chip = e.target.closest ? e.target.closest('#fmMonMonthDaysGrid .fmChip') : null;
      if(chip){
        chip.classList.toggle('isActive');
        chip.setAttribute('aria-pressed', chip.classList.contains('isActive') ? 'true' : 'false');
        renderMonthDayChips(collectMonthDays());
      }
    });

    root.addEventListener('dblclick', function(e){
      var rowEl = e.target.closest ? e.target.closest('#fmTableBody tr[data-rowid]') : null;
      if(rowEl){
        var id = rowEl.getAttribute('data-rowid') || '';
        state.selectedId = id;
        renderTable();
        openDetail(findRowById(id));
        return;
      }

      var monEl = e.target.closest ? e.target.closest('.fmMonitorItem[data-flowid]') : null;
      if(monEl){
        var fid = monEl.getAttribute('data-flowid') || '';
        openMonitorEditor(fid);
      }
    });

    root.addEventListener('input', function(e){
      if(e.target.id === 'fmSearch'){
        state.search = e.target.value || '';
        renderTable();
      }
    });

    root.addEventListener('change', function(e){
      if(e.target.id === 'fmSender'){
        state.sender = e.target.value || '';
        renderTable();
      }else if(e.target.id === 'fmReceiver'){
        state.receiver = e.target.value || '';
        renderTable();
      }else if(e.target.id === 'fmStatus'){
        state.status = e.target.value || '';
        renderTable();
      }else if(e.target.id === 'fmDateFrom' || e.target.id === 'fmDateTo'){
        var fromEl = byId('fmDateFrom');
        var toEl = byId('fmDateTo');
        var from = fromEl ? String(fromEl.value || '').trim() : '';
        var to = toEl ? String(toEl.value || '').trim() : '';
        if(from && to){
          state.range = { from: from, to: to };
          refresh().catch(showError);
        }else{
          render();
        }
      }else if(e.target.id === 'fmMonMode'){
        syncMonitorModeUi();
      }
    });
  }

  function showError(err){
    console.error(err);
    alert('Kunde inte ladda sidan: ' + (err && err.message ? err.message : err));
  }

  async function boot(){
    ensureRoot();
    try{
      await refresh();
    }catch(err){
      showError(err);
    }
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', boot);
  }else{
    boot();
  }

  w.FMClean = { refresh: refresh };
})(window);
