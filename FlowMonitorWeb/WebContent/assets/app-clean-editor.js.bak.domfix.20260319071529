  Editor.normalizeRule = function(flow){
    var x = {
      mode: 'interval',
      intervals: [],
      times: [],
      weekdayRules: [],
      monthDayRules: [],
      dateRules: []
    };

    var sched = (flow && flow.schedule && typeof flow.schedule === 'object') ? flow.schedule : null;
    if(!sched) return x;

    var t = String(sched.type || '').trim();
    if(t === 'interval'){
      x.mode = 'interval';
      x.intervals = Array.isArray(sched.intervals) ? sched.intervals : [];
    }else if(t === 'exactTimes' || t === 'exacttimes'){
      x.mode = 'exactTimes';
      x.times = Array.isArray(sched.times) ? sched.times : [];
    }else if(t === 'weekdays'){
      x.mode = 'weekdays';
      x.weekdayRules = Array.isArray(sched.rules) ? sched.rules : [];
    }else if(t === 'monthDays' || t === 'monthdays'){
      x.mode = 'monthDays';
      x.monthDayRules = Array.isArray(sched.rules) ? sched.rules : [];
    }else if(t === 'dates'){
      x.mode = 'dates';
      x.dateRules = Array.isArray(sched.rules) ? sched.rules : [];
    }
    return x;
  };

